# Online application configuration for local development.
# Copy this file to .env and replace placeholders locally. Never commit .env.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL_ID=gpt-4o-mini

# Opik tracing is opt-in. Set enabled to true only after configuring the
# cloud API key and workspace from your Opik account.
OPIK_ENABLED=false
OPIK_API_KEY=replace-with-your-opik-api-key
OPIK_WORKSPACE=replace-with-your-opik-workspace
OPIK_PROJECT_NAME=my-ai-assistant-online

# Retained for course components that still use Comet directly.
COMET_API_KEY=replace-with-your-comet-api-key

MONGODB_URI=mongodb://replace-with-user:replace-with-password@localhost:27017/my_ai_assistant?authSource=admin&directConnection=true
MONGODB_DATABASE_NAME=my_ai_assistant
MONGODB_RAG_COLLECTION_NAME=rag_chunks

RAG_RETRIEVER_K=5
RAG_DEVICE=cpu

AGENT_MAX_STEPS=3

EVALUATION_DATASET_NAME=my-ai-assistant-agentic-rag
EVALUATION_EXPERIMENT_NAME_PREFIX=agentic-rag
